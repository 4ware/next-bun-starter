# Postgres connection string (e.g. local Postgres, Neon, Supabase)
DATABASE_URL="postgres://postgres:postgres@localhost:5432/next_bun_starter"

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="change-me"

# Base URL of the app (used by better-auth)
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Standalone realtime WebSocket server (bun run dev:realtime)
REALTIME_PORT="3001"
NEXT_PUBLIC_REALTIME_URL="ws://localhost:3001"

# Redis (docker-compose `redis` service; not used by the app yet)
REDIS_URL="redis://localhost:6379"

# Directory for uploaded files (bytes only — metadata lives in Postgres)
UPLOADS_DIR=".uploads"
